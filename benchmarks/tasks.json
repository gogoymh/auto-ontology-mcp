{
  "version": "1",
  "description": "Fixed headless benchmark suite for auto-ontology-mcp against the built-in retail demo DB and demo knowledge base.",
  "seed": 7,
  "setup": {
    "relationships": [
      {
        "action": "accept",
        "source": "employees.manager_id",
        "target": "employees.employee_id"
      },
      {
        "action": "add",
        "source": "orders.sales_rep_id",
        "target": "employees.employee_id",
        "role": "sales rep"
      },
      {
        "action": "update",
        "source": "customers.delivery_city_id",
        "target": "cities.city_id",
        "is_default": true
      }
    ],
    "terms": {
      "regions": [
        {
          "name": "Region",
          "description": "A sales region grouping US states.",
          "columns": [
            {"column": "region_id", "display_name": "Region ID"},
            {"column": "region_name", "display_name": "Region Name"}
          ]
        }
      ],
      "states": [
        {
          "name": "State",
          "description": "A US state where customers live.",
          "synonyms": ["State Province"],
          "columns": [
            {"column": "state_id", "display_name": "State ID"},
            {"column": "state_name", "display_name": "State Name"},
            {"column": "state_code", "display_name": "State Code"}
          ]
        }
      ],
      "cities": [
        {
          "name": "City",
          "description": "A city used for customer delivery and billing addresses.",
          "columns": [
            {"column": "city_id", "display_name": "City ID"},
            {"column": "city_name", "display_name": "City Name"},
            {"column": "population", "display_name": "Population"}
          ]
        }
      ],
      "employees": [
        {
          "name": "Employee",
          "description": "A member of the sales organization.",
          "synonyms": ["Sales Rep"],
          "columns": [
            {"column": "employee_id", "display_name": "Employee ID"},
            {"column": "full_name", "display_name": "Full Name"},
            {"column": "job_title", "display_name": "Job Title"},
            {"column": "manager_id", "display_name": "Manager ID"},
            {"column": "hire_date", "display_name": "Hire Date"}
          ]
        }
      ],
      "customers": [
        {
          "name": "Customer",
          "description": "A customer account; one row per customer.",
          "synonyms": ["고객"],
          "columns": [
            {"column": "customer_id", "display_name": "Customer ID"},
            {"column": "customer_name", "display_name": "Customer Name"},
            {"column": "email", "display_name": "Email"},
            {"column": "segment", "display_name": "Segment"},
            {"column": "signup_date", "display_name": "Signup Date"},
            {"column": "is_active", "display_name": "Is Active"}
          ]
        }
      ],
      "product_categories": [
        {
          "name": "Product Category",
          "description": "A two-level product category tree.",
          "columns": [
            {"column": "category_id", "display_name": "Category ID"},
            {"column": "category_name", "display_name": "Category Name"}
          ]
        }
      ],
      "products": [
        {
          "name": "Product",
          "description": "A product in the catalog.",
          "columns": [
            {"column": "product_id", "display_name": "Product ID"},
            {"column": "product_name", "display_name": "Product Name"},
            {"column": "unit_price", "display_name": "List Price"},
            {"column": "unit_cost", "display_name": "Unit Cost"},
            {"column": "is_discontinued", "display_name": "Is Discontinued"}
          ]
        }
      ],
      "tags": [
        {
          "name": "Tag",
          "description": "A merchandising tag.",
          "columns": [
            {"column": "tag_id", "display_name": "Tag ID"},
            {"column": "tag_name", "display_name": "Tag Name"}
          ]
        }
      ],
      "orders": [
        {
          "name": "Order",
          "description": "A customer order; one row per order.",
          "columns": [
            {"column": "order_id", "display_name": "Order ID"},
            {"column": "order_date", "display_name": "Order Date"},
            {"column": "status", "display_name": "Order Status"},
            {"column": "channel", "display_name": "Sales Channel"}
          ]
        }
      ],
      "order_lines": [
        {
          "name": "Order Line",
          "description": "One product line of an order; revenue lives here.",
          "synonyms": ["Invoice Line"],
          "columns": [
            {"column": "order_line_id", "display_name": "Order Line ID"},
            {"column": "quantity", "display_name": "Quantity"},
            {"column": "unit_price", "display_name": "Unit Price"},
            {"column": "discount_pct", "display_name": "Discount Fraction"},
            {"column": "line_total", "display_name": "Revenue"}
          ]
        }
      ]
    },
    "sql_attributes": [
      {
        "term": "Order",
        "name": "Delivered Orders",
        "expression": "orders.status = 'Delivered'",
        "description": "Orders that reached the customer.",
        "kind": "filter",
        "status": "certified"
      },
      {
        "term": "Order Line",
        "name": "Net Revenue",
        "expression": "SUM(order_lines.line_total)",
        "description": "Revenue after discounts.",
        "kind": "measure",
        "status": "certified"
      },
      {
        "term": "Product",
        "name": "Average List Price",
        "expression": "AVG(products.unit_price)",
        "description": "Mean list price across products.",
        "kind": "measure",
        "status": "draft"
      }
    ],
    "glossary": [
      {
        "name": "GMV",
        "definition": "Order Line › Revenue (order_lines.line_total) summed over every order"
      },
      {
        "name": "AOV",
        "definition": "average order value"
      },
      {
        "name": "NPS",
        "definition": "net promoter score from surveys"
      }
    ],
    "seed_demo_knowledge": true
  },
  "relationship_inference": {
    "expected_inferred": [
      {
        "id": "rel_cities_state",
        "source": "cities.state_id",
        "target": "states.state_id",
        "status": "accepted",
        "role": null
      },
      {
        "id": "rel_customers_delivery_city",
        "source": "customers.delivery_city_id",
        "target": "cities.city_id",
        "status": "accepted",
        "role": "delivery"
      },
      {
        "id": "rel_customers_billing_city",
        "source": "customers.billing_city_id",
        "target": "cities.city_id",
        "status": "accepted",
        "role": "billing"
      },
      {
        "id": "rel_product_tags_product",
        "source": "product_tags.product_id",
        "target": "products.product_id",
        "status": "accepted",
        "role": null
      },
      {
        "id": "rel_product_tags_tag",
        "source": "product_tags.tag_id",
        "target": "tags.tag_id",
        "status": "accepted",
        "role": null
      },
      {
        "id": "rel_orders_customer",
        "source": "orders.customer_id",
        "target": "customers.customer_id",
        "status": "accepted",
        "role": null
      },
      {
        "id": "rel_order_lines_product",
        "source": "order_lines.product_id",
        "target": "products.product_id",
        "status": "accepted",
        "role": null
      },
      {
        "id": "rel_employees_manager",
        "source": "employees.manager_id",
        "target": "employees.employee_id",
        "status": "proposed",
        "role": "manager"
      }
    ],
    "expected_unlinked": [
      {
        "id": "unlinked_sales_rep",
        "column": "orders.sales_rep_id",
        "must_suggest_target": "employees.employee_id"
      }
    ],
    "forbidden_unlinked": [
      {
        "id": "not_unlinked_state_code",
        "column": "states.state_code"
      }
    ],
    "expected_junctions": [
      {
        "id": "junction_product_tags",
        "table": "product_tags"
      }
    ]
  },
  "ontology_search": [
    {
      "id": "os_synonym_invoice",
      "datasource": "demo",
      "query": "invoice line",
      "expected_any": ["Order Line"]
    },
    {
      "id": "os_attr_revenue",
      "datasource": "demo",
      "query": "revenue",
      "expected_any": ["Order Line › Net Revenue", "Order Line › Revenue"]
    },
    {
      "id": "os_korean_customer",
      "datasource": "demo",
      "query": "고객",
      "expected_any": ["Customer"]
    },
    {
      "id": "os_sql_attr_delivered",
      "datasource": "demo",
      "query": "delivered orders",
      "expected_any": ["Order › Delivered Orders"]
    },
    {
      "id": "os_sql_attr_net_revenue",
      "datasource": "demo",
      "query": "net revenue",
      "expected_any": ["Order Line › Net Revenue"]
    },
    {
      "id": "os_glossary_gmv",
      "datasource": "demo",
      "query": "GMV",
      "expected_any": ["GMV"]
    },
    {
      "id": "os_typo_customer",
      "datasource": "demo",
      "query": "custmer",
      "expected_any": ["Customer"]
    },
    {
      "id": "os_question_region",
      "datasource": "demo",
      "query": "Which region has the most employees?",
      "expected_any": ["Region", "Employee"]
    },
    {
      "id": "os_question_no_manager",
      "datasource": "demo",
      "query": "Which employees have no manager?",
      "expected_any": ["Employee", "Employee › Manager ID"]
    },
    {
      "id": "os_attr_discount",
      "datasource": "demo",
      "query": "discount fraction",
      "expected_any": ["Order Line › Discount Fraction"]
    },
    {
      "id": "os_term_category",
      "datasource": "demo",
      "query": "product category",
      "expected_any": ["Product Category"]
    },
    {
      "id": "os_knowledge_bestseller",
      "datasource": "knowledge",
      "query": "bestseller",
      "expected_any": ["Bestseller Tag"]
    },
    {
      "id": "os_knowledge_cutover",
      "datasource": "knowledge",
      "query": "Lakeshore cutover",
      "expected_any": ["Fulfilment Cutover"]
    },
    {
      "id": "os_knowledge_decision",
      "datasource": "knowledge",
      "query": "Decision",
      "expected_any": ["Action Item"]
    },
    {
      "id": "os_negative_unrelated",
      "datasource": "demo",
      "query": "quantum entanglement telemetry",
      "expect_empty": true
    }
  ],
  "fulltext_search": [
    {
      "id": "ft_bestseller_term",
      "query": "bestseller",
      "kinds": ["term"],
      "expected_field": "name",
      "expected_any": ["Bestseller Tag"]
    },
    {
      "id": "ft_bestseller_passage",
      "query": "bestseller",
      "kinds": ["passage"],
      "expected_field": "heading",
      "expected_any": ["bestseller"]
    },
    {
      "id": "ft_midwest_summary",
      "query": "Midwest January September",
      "kinds": ["passage"],
      "expected_field": "heading",
      "expected_any": ["Summary"]
    },
    {
      "id": "ft_ear_cushions",
      "query": "ear cushions cracked",
      "kinds": ["passage"],
      "expected_field": "heading",
      "expected_any": ["Noise Cancelling Headphones"]
    },
    {
      "id": "ft_wobbling_chair",
      "query": "wobbling base",
      "kinds": ["passage"],
      "expected_field": "heading",
      "expected_any": ["Office Chair"]
    },
    {
      "id": "ft_columbus_lakeshore",
      "query": "Columbus Lakeshore",
      "kinds": ["passage"],
      "expected_field": "heading",
      "expected_any": ["January cutover"]
    },
    {
      "id": "ft_gas_valve",
      "query": "gas valve",
      "kinds": ["passage"],
      "expected_field": "heading",
      "expected_any": ["Camping Stove"]
    },
    {
      "id": "ft_ssd_slowdown",
      "query": "slowing down hot",
      "kinds": ["term"],
      "expected_field": "name",
