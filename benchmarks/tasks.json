    {
      "id": "ft_negative_miss",
      "query": "supernova hyperdrive",
      "expect_empty": true
    }
  ],
  "check_answerable": [
    {
      "id": "ca_revenue_by_state",
      "datasource": "demo",
      "question": "Revenue by state in 2024",
      "entities": ["revenue", "state"],
      "expected_verdict": "answerable",
      "expected_link_states": ["linked"]
    },
    {
      "id": "ca_value_lookup",
      "datasource": "demo",
      "question": "What was revenue for the sushi roll flash drive in Pennsylvania in June 2024?",
      "entities": ["revenue", "sushi roll flash drive", "Pennsylvania"],
      "expected_verdict": "answerable",
      "expected_entity_states": {
        "Pennsylvania": "covered_by_value",
        "sushi roll flash drive": "covered_by_value"
      }
    },
    {
      "id": "ca_glossary_gmv",
      "datasource": "demo",
      "question": "GMV by state",
      "entities": ["GMV", "state"],
      "expected_verdict": "answerable",
      "expected_entity_states": {
        "GMV": "covered_via_glossary"
      },
      "expected_link_states": ["linked"]
    },
    {
      "id": "ca_sql_attr_delivered",
      "datasource": "demo",
      "question": "How many delivered orders?",
      "entities": ["delivered orders"],
      "expected_verdict": "answerable"
    },
    {
      "id": "ca_auto_grammar_has",
      "datasource": "demo",
