    },
    {
      "id": "ca_parent_in_question",
      "datasource": "demo",
      "question": "Revenue and number of tags per product",
      "entities": ["revenue", "tag", "product"],
      "expected_verdict": "answerable",
      "expected_link_states": ["through_parent_in_question"]
    },
    {
      "id": "ca_partial_ad_spend",
      "datasource": "demo",
      "question": "Return on ad spend for flash drives",
      "entities": ["ad spend", "return on ad spend", "flash drive"],
