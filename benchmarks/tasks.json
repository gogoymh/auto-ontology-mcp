    },
    {
      "id": "ca_glossary_unbacked_nps",
      "datasource": "demo",
      "question": "NPS by segment",
      "entities": ["NPS", "segment"],
      "expected_verdict": "partially_answerable",
      "expected_entity_states": {
        "NPS": "not_covered"
      }
    },
    {
      "id": "ca_knowledge_concepts",
      "datasource": "knowledge",
      "question": "How did Delivery Delay relate to Midwest Sales Decline 2024?",
      "entities": ["Delivery Delay", "Midwest Sales Decline 2024"],
      "expected_verdict": "answerable"
    }
  ],
  "validate_sql": [
    {
      "id": "vs_trap_delete",
      "datasource": "demo",
      "sql": "DELETE FROM orders WHERE order_id = 1",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["SELECT"]
    },
    {
      "id": "vs_trap_multistmt",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM orders; DROP TABLE orders",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["one statement"]
    },
    {
      "id": "vs_trap_unknown_table",
      "datasource": "demo",
      "sql": "SELECT * FROM ad_spend",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["not in the catalog"]
    },
    {
      "id": "vs_trap_unknown_column",
      "datasource": "demo",
      "sql": "SELECT revenue FROM order_lines",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["order_lines.line_total"]
    },
    {
      "id": "vs_trap_wrong_join",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM orders o JOIN customers c ON o.order_id = c.customer_id",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["orders.customer_id = customers.customer_id"]
    },
    {
      "id": "vs_trap_placeholder_false",
      "datasource": "demo",
      "sql": "SELECT order_id FROM orders WHERE 1 = 0",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["never true"]
    },
    {
      "id": "vs_trap_placeholder_null",
      "datasource": "demo",
      "sql": "SELECT NULL AS revenue FROM orders",
      "is_trap": true,
      "expected_valid": false,
      "expect_error_contains": ["constant NULL"]
    },
    {
      "id": "vs_trap_fanout_one_side",
      "datasource": "demo",
      "sql": "SELECT SUM(p.unit_price) FROM products p JOIN order_lines l ON l.product_id = p.product_id",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["Fan-out"]
    },
    {
      "id": "vs_trap_fanout_sibling",
      "datasource": "demo",
      "sql": "SELECT p.product_name, SUM(l.line_total) AS revenue FROM products p JOIN order_lines l ON l.product_id = p.product_id JOIN product_tags pt ON pt.product_id = p.product_id GROUP BY p.product_name",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["Fan-out", "related only through products"]
    },
    {
      "id": "vs_trap_literal_case",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM orders WHERE status = 'shipped'",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["'Shipped'"]
    },
    {
      "id": "vs_trap_literal_select",
      "datasource": "demo",
      "sql": "SELECT SUM(o.status = 'shipped') FROM orders o",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["'Shipped'"]
    },
    {
      "id": "vs_trap_literal_product",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM products WHERE product_name = 'Sushi Roll Flash Drive'",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["'USB Food Flash Drive - Sushi Roll'"]
    },
    {
      "id": "vs_trap_percent_range",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM order_lines WHERE discount_pct > 20",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["Did you mean 0.2"]
    },
    {
      "id": "vs_trap_percent_question",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM order_lines l WHERE l.discount_pct < 0.2",
      "question": "How many order lines had a discount under 0.2%?",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["Did you mean 0.002"]
    },
    {
      "id": "vs_trap_integer_division",
      "datasource": "demo",
      "sql": "SELECT SUM(quantity) / COUNT(*) FROM order_lines",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["Integer division"]
    },
    {
      "id": "vs_trap_vacuous_groupby",
      "datasource": "demo",
      "sql": "SELECT order_id, COUNT(*) FROM orders GROUP BY order_id",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["every group is a single row"]
    },
    {
      "id": "vs_trap_unaggregated_many",
      "datasource": "demo",
      "sql": "SELECT o.order_id, ol.quantity, COUNT(*) FROM orders o JOIN order_lines ol ON ol.order_id = o.order_id GROUP BY o.order_id",
      "is_trap": true,
      "expected_valid": true,
      "expect_warning_contains": ["without an aggregate"]
    },
    {
      "id": "vs_clean_multihop_revenue",
      "datasource": "demo",
      "sql": "SELECT s.state_name, ROUND(SUM(l.line_total), 2) AS revenue FROM order_lines l JOIN orders o ON o.order_id = l.order_id JOIN customers c ON c.customer_id = o.customer_id JOIN cities ci ON ci.city_id = c.delivery_city_id JOIN states s ON s.state_id = ci.state_id WHERE o.status = 'Delivered' GROUP BY s.state_name ORDER BY revenue DESC",
      "is_trap": false,
      "expected_valid": true,
      "forbid_warnings": true
    },
    {
      "id": "vs_clean_billing_role",
      "datasource": "demo",
      "sql": "SELECT COUNT(*) FROM customers c JOIN cities ci ON ci.city_id = c.billing_city_id",
      "is_trap": false,
      "expected_valid": true,
      "forbid_warnings": true,
      "expect_note_contains": ["'billing' role"]
    },
    {
      "id": "vs_clean_line_cost",
      "datasource": "demo",
      "sql": "SELECT SUM(l.quantity * p.unit_cost) FROM order_lines l JOIN products p ON p.product_id = l.product_id",
      "is_trap": false,
      "expected_valid": true,
      "forbid_warnings": true
    },
    {
      "id": "vs_clean_conditional_sum",
      "datasource": "demo",
      "sql": "SELECT SUM(CASE WHEN o.order_date < '2024-01-01' THEN l.line_total END) FROM order_lines l JOIN orders o ON o.order_id = l.order_id",
      "is_trap": false,
      "expected_valid": true,
      "forbid_warnings": true
    },
    {
      "id": "vs_clean_float_division",
      "datasource": "demo",
      "sql": "SELECT CAST(SUM(quantity) AS REAL) / COUNT(*) FROM order_lines",
      "is_trap": false,
      "expected_valid": true,
      "forbid_warnings": true
    },
    {
      "id": "vs_clean_preagg_chasm",
      "datasource": "demo",
      "sql": "SELECT p.product_name, s.revenue, g.tags FROM products p JOIN (SELECT product_id, SUM(line_total) AS revenue FROM order_lines GROUP BY product_id) s ON s.product_id = p.product_id JOIN (SELECT product_id, COUNT(*) AS tags FROM product_tags GROUP BY product_id) g ON g.product_id = p.product_id",
      "is_trap": false,
      "expected_valid": true,
      "forbid_warnings": true
    },
    {
      "id": "vs_clean_percent_scale",
